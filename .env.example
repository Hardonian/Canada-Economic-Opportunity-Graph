# Copy to .env for local Docker Compose use. Never commit the populated file.
API_PORT=8080
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
STORAGE_MODE=persistent
STORAGE_DIR=data/store
# Set to 0 for immutable snapshot-only serving. Production Compose enables a
# five-minute single-writer refresh loop inside the API process.
INGEST_INTERVAL=5m

# Official World Bank Indicators API is public and needs no credential.
# Set live only when the API runtime has outbound network access; snapshot is
# the deterministic default.
GLOBAL_TRADE_MODE=snapshot
GLOBAL_TRADE_FIXTURE=data/fixtures/world_bank_trade_canada.json

# Credential-free official adapters. Each falls back to its reviewed fixture
# if the publisher is unavailable or the flag remains disabled.
BANKOFCANADA_LIVE=0
FEDERAL_CONTRACTS_LIVE=0
LOBBYIST_REGISTRY_LIVE=0
CMHC_HOUSING_LIVE=0

# Public AdSense publisher identifier (not a secret). Leave blank to disable
# ads entirely. Enable Auto ads + side rails in the approved AdSense account.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Reserved for future promoted adapters. Never commit issued keys.
WTO_API_KEY=
UN_COMTRADE_API_KEY=

# Optional: enables adapter-sandbox approval/deletion endpoints. Generate at
# least 32 random characters and inject it through your secret manager.
# Leave empty to keep those mutation endpoints disabled.
ADAPTER_ADMIN_SECRET=

# Required for encrypted execution-workspace sessions in production. Generate
# at least 32 random characters in your secret manager; local development
# intentionally reports DEMO mode until this is set.
COG_WORKSPACE_SECRET=

# Enterprise deal room (required together; private endpoints fail closed until
# configured). Auth0 is the OIDC session boundary and can federate SAML/AD/Entra
# connections for each customer tenant.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
COG_DEALROOM_GATEWAY_SECRET=
COG_DEALROOM_ENCRYPTION_KEY=
COG_DEALROOM_MAX_DOCUMENT_BYTES=26214400
